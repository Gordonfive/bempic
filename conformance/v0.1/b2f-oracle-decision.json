    ]
  },
  "comparison_profile": {
    "id": "bempic-v0.1-b2f-text-single-message-v1",
    "fixture_scope": "one-message-per-independent-no-fault-run",
    "batching": "forbidden",
    "raw_input": {
      "format": "rfc5322-mime-exact-bytes",
      "line_endings": "crlf",
      "content_type": "text/plain; charset=us-ascii",
      "content_transfer_encoding": "7bit",
      "body": "non-empty-single-part",
      "attachments": 0,
      "bcc": "forbidden",
      "transport_trace_fields": "forbidden",
      "measured_as_b2f_bytes": false
    },
    "fixed_fixture_fields": [
      "date_utc_minute",
      "from",
      "ordered_to",
      "ordered_cc",
      "subject",
      "mime_message_id",
      "b2_mid",
      "b2_mbo",
      "body_bytes"
    ],
    "prepared_b2_image": {
      "encoding": "ascii",
      "line_endings": "crlf",
      "header_order": [
        "Mid",
        "Date",
        "Type",
        "From",
        "To",
        "Cc",
        "Subject",
        "Mbo",
        "Body"
      ],
      "type_value": "Private",
      "date_format": "YYYY/MM/DD HH:MM",
      "body_length_unit": "octets-excluding-terminating-crlf",
      "ending": "empty-header-line-then-body-then-crlf",
      "oracle_may_rewrite": false
    },
    "lzhuf": {
      "variant": "FBB-LZHUF_1-with-B2-prefix",
      "behavior_reference": {
        "repository": "ARSFI/Winlink-Compression",
        "commit": "dbe96569817018e66e0e5f6add40eed12adc9fd7",
        "path": "WinlinkSupport.vb",
        "git_blob_sha1": "1430cf408b28d9345e6b4a75c1c97fdaebb3661d",
        "entry_point": "Compression.Encode(input, output, prependCRC=True)"
      },
      "lzss_ring_octets": 2048,
      "lookahead_octets": 60,
      "match_threshold": 2,
      "initial_ring_octet": 32,
      "adaptive_huffman_symbols": 314,
      "adaptive_huffman_rebuild_frequency": 32768,
      "crc": {
        "name": "CRC-16/XMODEM",
        "polynomial": 4129,
        "initial": 0,
        "reflect_input": false,
        "reflect_output": false,
        "xor_output": 0,
        "stored_byte_order": "little-endian",
        "coverage": "four-octet-length-plus-compressed-bitstream"
      },
      "uncompressed_length": {
        "octets": 4,
        "byte_order": "little-endian",
        "signed": false
      },
      "image_order": [
        "crc16-two-octets",
        "uncompressed-length-four-octets",
        "lzhuf-bitstream"
      ]
    },
    "b2f_envelope": {
      "start": "first-octet-of-fc-proposal",
      "end": "checksum-octet-following-eot",
      "offset": 0,
      "proposal_template": "FC EM {mid} {uncompressed_size} {compressed_size} 0\\r",
      "proposal_prompt_template": "F> {uppercase-two-digit-hex-checksum}\\r",
      "proposal_checksum": "twos-complement-modulo-256-of-proposal-including-cr",
      "acceptance": "FS +\\r",
      "binary_header": "01 header-length subject 00 ascii-0 00",
      "binary_header_length": "subject-octets-plus-3",
      "data_block_payload_octets": 250,
      "data_block": "02 length data",
      "termination": "04 twos-complement-modulo-256-of-all-transmitted-image-data",
      "directions": {
        "send": "proposal-prompt-binary-header-data-blocks-eot-checksum",
        "receive": "acceptance",
        "identity": "b2f_total_bytes=b2f_send_bytes+b2f_receive_bytes"
      },
      "included": [
        "fc-proposal",
        "proposal-checksum-line",
        "fs-acceptance",
        "binary-header",
        "data-block-prefixes",
        "complete-lzhuf-image",
        "eot",
        "transfer-checksum"
      ],
      "excluded": [
        "raw-mime-bytes",
        "mime-and-b2-preparation-work",
        "login-greeting-sid",
        "pq-pr-authentication",
        "comments",
        "line-echo",
        "later-turn-ff-fq-session-close",
        "modem-carrier-link-framing",
        "fec",
        "lower-layer-acknowledgements",
        "lower-layer-retransmissions",
        "failed-or-resumed-attempts"
      ]
    },
    "calculations": {
      "candidate_reduction_percent": "100*(b2f_total_bytes-bempic_total_bytes)/b2f_total_bytes",
      "candidate_increase_percent": "100*(bempic_total_bytes-b2f_total_bytes)/b2f_total_bytes",
      "representation": "signed-integer-numerator-and-positive-integer-denominator",
      "median": "exact-median-of-per-fixture-reduction-rationals",
      "even_median": "arithmetic-mean-of-two-middle-rationals",
      "forbidden_aggregations": [
        "ratio-of-aggregate-byte-totals",
        "ratio-of-two-medians"
      ]
    }
  },
