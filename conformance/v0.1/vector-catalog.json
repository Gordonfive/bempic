      "selected_oracle": null,
      "corpus_digest": null,
      "blocked_by": ["b2f-oracle-selection", "prescribed-corpus-publication", "independent-reproduction"],
      "threshold_ids": ["b2f-median-compactness", "b2f-per-fixture-regression"]
